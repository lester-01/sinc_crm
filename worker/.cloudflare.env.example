# Copy to worker/.cloudflare.env (never commit .cloudflare.env)
# Optional but recommended: scoped API token from Cloudflare dashboard.
# See docs/quick-start.md — "Cloudflare API token (scoped)".
#
# If these are set, wrangler uses them without a browser (good for CI and scripts).
# If empty, setup:cloud falls back to browser OAuth after checking existing wrangler login.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
