# Copy to worker/.dev.vars yourself (never commit .dev.vars). Installers do NOT copy this.
# Cloudflare scoped token: worker/.cloudflare.env (see worker/.cloudflare.env.example)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# Required for npm run db:schema (Supabase CLI → Postgres)
# Dashboard → Connect → ORM / Transaction pooler (port 6543, serverless-safe)
# Paste the URI exactly as shown; use [YOUR-PASSWORD] placeholder or embed password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres

# Required only if SUPABASE_DB_URL contains [YOUR-PASSWORD]
# Dashboard → search "password" → Database password (shown once; reset if lost)
SUPABASE_DB_PASSWORD=your-database-password
