# Copy to worker/.dev.vars yourself (never commit .dev.vars). Installers do NOT copy this.
# Cloudflare scoped token: worker/.cloudflare.env (see worker/.cloudflare.env.example)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# Required for npm run db:schema (Supabase CLI → Postgres)
# Dashboard → search "password" → reset/copy database password (shown once at project creation)
SUPABASE_DB_PASSWORD=your-database-password

# Recommended: Session pooler URI from Database page (overrides host/user below)
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
