# Copy to worker/.dev.vars yourself (never commit .dev.vars). Installers do NOT copy this.
# Cloudflare scoped token: worker/.cloudflare.env (see worker/.cloudflare.env.example)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# Required for npm run db:schema (Supabase CLI → Postgres)
# Dashboard → Project Settings → Database → database password
SUPABASE_DB_PASSWORD=your-database-password

# Optional: full URI instead of SUPABASE_DB_PASSWORD
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
