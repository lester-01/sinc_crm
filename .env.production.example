# Copy to .env.production for production frontend builds (never commit .env.production).
# Used by: npm run build (Vite production mode loads this file automatically).
# See docs/deploy-guide.md

# Same Supabase project as production (or a dedicated prod project).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Deployed Worker URL (no trailing slash) — set after: npm run deploy:worker
VITE_API_BASE_URL=https://sinc-crm-api.your-subdomain.workers.dev
