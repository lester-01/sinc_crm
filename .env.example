# Copy to .env (never commit .env). See docs/quick-start.md and docs/external-auth.md.
#
# One file for local dev, deploy tooling, and wrangler dev (--env-file ../.env).
# Supabase values are stored once under SUPABASE_* — the Vite frontend receives
# publishable values at build/dev time via vite.config.ts (not duplicate VITE_SUPABASE_* keys).

# --- Supabase (Dashboard → Project Settings → API) ---
# Project URL — same value used by frontend (derived) and Worker
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key — public; safe to expose in the browser bundle via Vite define
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Secret (service role) key — never exposed to the frontend; Worker + db scripts only
SUPABASE_SECRET_KEY=your-secret-key

# --- Frontend → Worker API (Vite only; not a Supabase duplicate) ---
# Local: wrangler dev default. Production: deploy:all sets this from Cloudflare API at build time.
VITE_API_BASE_URL=http://localhost:8787

# --- Supabase database (npm run db:schema) ---
# Dashboard → Connect → ORM / Transaction pooler (port 6543)
# Paste the URI as shown; use [YOUR-PASSWORD] placeholder or embed the password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres
# Required only if SUPABASE_DB_URL contains [YOUR-PASSWORD]
SUPABASE_DB_PASSWORD=your-database-password

# --- Supabase account (optional) ---
# Required for npm run deploy:all (Auth URL sync) and isolated E2E (npm run test:e2e)
# SUPABASE_ACCESS_TOKEN=your-personal-access-token
# SUPABASE_ORG_SLUG=your-org-slug

# --- Cloudflare (P3 deploy — see docs/deploy-guide.md) ---
# Not required for local dev without deploy
# CLOUDFLARE_API_TOKEN=your-scoped-api-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# --- Worker production CORS (optional until Pass 2 deploy) ---
# CORS_ORIGINS=https://your-project.pages.dev
