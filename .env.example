# Copy to .env yourself (never commit .env). Installers do NOT copy this file.
# Used by Vite frontend and stack verification (verify:stack:env).
# Supabase service role + Cloudflare token: worker/.dev.vars and worker/.cloudflare.env
# See docs/quick-start.md — "Environment files (Phase 4)".

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Or Supabase dashboard "publishable" key:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Local Worker API (wrangler dev default). Set to deployed Worker URL after deploy.
VITE_API_BASE_URL=http://localhost:8787
