# Copy to .env yourself (never commit .env). Installers do NOT copy this file.
# Used by Vite frontend and stack verification (verify:supabase).
# Supabase secret + Cloudflare: worker/.dev.vars and worker/.cloudflare.env (see quick-start)
# See docs/quick-start.md — "Environment files (Phase 4)".

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Local Worker API (wrangler dev default). deploy:all sets production URL via Cloudflare API.
VITE_API_BASE_URL=http://localhost:8787
