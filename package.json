{
  "name": "sinc-student-crm",
  "private": true,
  "type": "module",
  "description": "Student CRM + Chat + Deal Pipeline",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "install:linux": "bash scripts/install.sh",
    "install:project": "bash scripts/install-project.sh",
    "setup:local": "bash scripts/install-local-deps.sh",
    "setup:worker": "bash scripts/install-worker-deps.sh",
    "setup:frontend": "bash scripts/install-frontend-deps.sh",
    "setup:cloud": "bash scripts/setup-cloud.sh",
    "db:schema": "node scripts/db-apply-schema.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "verify:stack": "node scripts/verify-stack-setup.mjs",
    "verify:stack:full": "node scripts/verify-stack-setup.mjs --phase=full",
    "verify:stack:local": "node scripts/verify-stack-setup.mjs --phase=local",
    "verify:stack:cloud": "node scripts/verify-stack-setup.mjs --phase=cloud",
    "verify:stack:cloudflare": "node scripts/verify-stack-setup.mjs --phase=cloudflare",
    "verify:stack:env": "node scripts/verify-stack-setup.mjs --phase=env",
    "verify:stack:supabase": "node scripts/verify-stack-setup.mjs --phase=supabase",
    "verify:stack:github": "node scripts/verify-stack-setup.mjs --phase=github",
    "verify:stack:scaffold": "node scripts/verify-stack-setup.mjs --phase=scaffold",
    "verify:stack:deploy": "node scripts/verify-stack-setup.mjs --phase=deploy",
    "verify:github-actions": "node scripts/verify-github-actions.mjs",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:ui": "node scripts/e2e-run.mjs --ui",
    "test:e2e:ui:dev": "node scripts/e2e-run.mjs --dev --ui",
    "test:e2e:dev": "playwright test",
    "test:worker": "npm run test --prefix worker",
    "test:scripts": "node --test scripts/lib/load-stack-env.test.mjs scripts/lib/auth-ladder.integration.test.mjs",
    "test:tooling": "npm run test:scripts && npm run test:worker",
    "deploy:worker": "bash scripts/deploy-worker.sh",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "deploy": "npm run deploy:worker && npm run deploy:pages",
    "verify:playwright": "node scripts/verify-playwright.mjs",
    "playwright:setup": "node scripts/install-playwright.mjs",
    "playwright:install": "npx playwright install chromium",
    "playwright:install-deps": "bash scripts/install-playwright-deps.sh",
    "playwright:install-deps:debian": "bash scripts/install-playwright-deps-debian.sh",
    "lint:openapi": "npx @redocly/cli lint docs/api/openapi.yaml --config redocly.yaml"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.74.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "supabase": "2.101.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
